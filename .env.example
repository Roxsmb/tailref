# TailRef Studio - isteğe bağlı ortam değişkenleri
#
# ÖNEMLİ: Bu projede API anahtarı, veritabanı şifresi, JWT veya benzeri bir
# şey KULLANILMAZ. Bu dosya yalnızca geliştirme/test kolaylığı içindir.
#
# Uygulama .env dosyasını kendiliğinden yüklemez. Değerleri kabuğa/CI ortamına
# verin; örneğin:  set TailRef_PORT=5178 && npm start
# .env dosyasını asla commit etmeyin (.gitignore'da hariç tutulur).

# --- Statik sunucu (dev-server / scripts) ---
# 1-65535 arası bir port. Varsayılan: 5173
PORT=5173
# 1 = tarayıcıyı otomatik açma (CI için)
NO_OPEN=0

# --- Masaüstü (Electron) test/otomasyon ---
# Uygulama içi statik sunucu portu. Sabit kural: IndexedDB deposu origin'e
# bağlı olduğu için üretimde değiştirmeyin.
TailRef_PORT=5178
# İzole test profili; yalnızca test modunda okunur (TEST_ENV).
# Boş bırakılırsa %APPDATA%\TailRef kullanılır.
TailRef_USER_DATA=
# Pinterest testi için yerel fixture adresi
TailRef_PINTEREST_URL=
# ArtStation testi için yerel fixture adresi
TailRef_ARTSTATION_URL=
# Panel testlerinde görsellerin kaydedileceği geçici klasör
TailRef_DOWNLOAD_DIR=
# Panel testlerinde ekran görüntüsü/izleme yolu (compositor/ink testleri)
TailRef_TEST_SCREEN=

# --- NSIS kurulumu ---
# Sessiz kurulumda hedef klasörü geçersiz kılar (build/installer.nsh)
TailRef_INSTALL_DIR=
