<?xml version="1.0" encoding="UTF-8"?>
<!-- TailRef board files (.tail).
     Installed by the Flatpak build as /app/share/mime/packages/com.tailref.studio.xml.
     The deb, rpm and AppImage packages get an equivalent file generated by
     electron-builder from build.fileAssociations in package.json, so this
     file is only needed for Flatpak. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-tailref-board">
    <comment>TailRef Studio document</comment>
    <comment xml:lang="tr">TailRef Studio belgesi</comment>
    <glob pattern="*.tail"/>
  </mime-type>
</mime-info>
