{
  "name": "tailref",
  "version": "1.4.4",
  "description": "TailRef — a free and open-source reference board, drawing workspace and 3D posing tool for artists.",
  "desktopName": "tailref.desktop",
  "main": "src/main/main.js",
  "author": "Emre Melik Nameli",
  "license": "GPL-3.0-or-later",
  "private": true,
  "keywords": [
    "art",
    "drawing",
    "reference-board",
    "3d-posing",
    "artist-tools",
    "electron"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bundle": "node scripts/build-app.js",
    "build:native": "node scripts/build-native.js",
    "start": "node scripts/build-app.js && electron .",
    "build": "node scripts/build-app.js && node scripts/build-native.js && electron-builder --win",
    "build:portable": "node scripts/build-app.js && node scripts/build-native.js && electron-builder --win portable",
    "build:setup": "node scripts/build-app.js && node scripts/build-native.js && electron-builder --win nsis",
    "build:dir": "node scripts/build-app.js && node scripts/build-native.js && electron-builder --win dir",
    "build:linux": "node scripts/build-app.js && node scripts/build-native.js && electron-builder --linux --publish never",
    "build:linux:dir": "node scripts/build-app.js && node scripts/build-native.js && electron-builder --linux dir",
    "build:mac": "node scripts/build-app.js && node scripts/build-native.js && electron-builder --mac --publish never",
    "build:mac:dir": "node scripts/build-app.js && node scripts/build-native.js && electron-builder --mac dir",
    "release:notes": "node scripts/release-notes.js",
    "gates": "node scripts/run-gates.js",
    "gates:full": "node scripts/run-gates.js --full",
    "test": "node scripts/build-app.js && node tests/update-policy-test.js && node tests/update-manager-test.js && node tests/update-static-test.js && node tests/pose3d-unit.js && node tests/smoke-test.js && node tests/pinterest-test.js && node tests/artstation-test.js",
    "test:smoke": "node scripts/build-app.js && node tests/smoke-test.js",
    "test:desktop": "node scripts/build-app.js && node tests/desktop-smoke.js",
    "test:ink": "node scripts/build-app.js && node tests/ink-smoke.js",
    "qa:fx": "node scripts/build-app.js && node tests/fx-visual-qa.js",
    "test:select": "node scripts/build-app.js && node tests/ink-select-check.js",
    "test:radial": "node scripts/build-app.js && node tests/ink-radial-check.js",
    "test:outside": "node scripts/build-app.js && node tests/ink-outside-check.js",
    "test:commit": "node scripts/build-app.js && node tests/ink-commit-check.js",
    "test:compositor": "node scripts/build-app.js && node tests/compositor-test.js",
    "bench:ink": "node scripts/build-app.js && node scripts/ink-bench.js",
    "test:package": "node scripts/verify-package.js",
    "test:projects": "node scripts/build-app.js && node tests/projects-test.js",
    "test:overload": "node scripts/build-app.js && node tests/overload-test.js",
    "test:close": "node scripts/build-app.js && node tests/save-on-close-test.js",
    "test:pinterest": "node scripts/build-app.js && node tests/pinterest-test.js",
    "test:artstation": "node scripts/build-app.js && node tests/artstation-test.js",
    "test:pose3d": "node tests/pose3d-smoke.js",
    "test:unit": "node tests/pose3d-unit.js",
    "test:update": "node tests/update-policy-test.js && node tests/update-manager-test.js && node tests/update-static-test.js"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "node-gyp": "12.4.0"
  },
  "build": {
    "appId": "com.tailref.studio",
    "productName": "TailRef Studio",
    "copyright": "Copyright © 2026 Emre Melik Nameli",
    "asar": true,
    "fileAssociations": [
      {
        "ext": "tail",
        "name": "TailRef Board",
        "description": "TailRef Studio document",
        "role": "Editor",
        "mimeType": "application/x-tailref-board"
      }
    ],
    "files": [
      "src/main/**",
      "src/preload/**",
      "src/renderer/**",
      "native/inkcore/build/Release/inkcore.node",
      "LICENSE",
      "LICENSE-FAQ.md",
      "NOTICE",
      "TRADEMARK.md",
      "THIRD_PARTY_NOTICES.md",
      "docs/licenses/**"
    ],
    "asarUnpack": [
      "native/inkcore/build/Release/inkcore.node"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Roxsmb",
        "repo": "tailref",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "build/icon.ico",
          "to": "icon.ico"
        }
      ],
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Windows-TailRef-${version}-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TailRef Studio",
      "uninstallDisplayName": "TailRef Studio",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Windows-TailRef-${version}-Setup.${ext}",
      "language": "1055",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "icon": "build/icon.png",
      "executableName": "tailref",
      "category": "Graphics",
      "synopsis": "Reference board, drawing workspace and 3D posing tool for artists",
      "description": "TailRef Studio is a free, open-source desktop workspace for artists who work from references. Collect reference images on an infinite board, draw over them with a pressure-sensitive ink engine, and pose 3D models in one offline project.",
      "maintainer": "Emre Melik Nameli <tailrefstudio@gmail.com>",
      "vendor": "Emre Melik Nameli",
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "Name": "TailRef Studio",
          "GenericName": "Reference board and drawing workspace",
          "Comment": "Collect references, draw over them and pose 3D models in one window.",
          "Keywords": "art;drawing;reference;3d;pose;sketch;"
        }
      }
    },
    "appImage": {
      "artifactName": "Linux-TailRef-${version}-x86_64.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true,
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "macOS-TailRef-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "Linux-TailRef-${version}-amd64.${ext}",
      "packageName": "tailref",
      "priority": "optional",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "shared-mime-info",
        "desktop-file-utils"
      ]
    },
    "rpm": {
      "artifactName": "Linux-TailRef-${version}-x86_64.${ext}",
      "packageName": "tailref",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "(libsecret or libsecret-1-0)",
        "shared-mime-info",
        "desktop-file-utils"
      ]
    },
    "compression": "normal",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    }
  },
  "allowScripts": {
    "electron@45.4.1": true
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
