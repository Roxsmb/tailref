# ---------------------------------------------------------------------------
# TailRef — repository ignores
# ---------------------------------------------------------------------------

# Node
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output (regenerated by scripts/build-app.js + electron-builder)
/dist/
/dist-test/
/dist-gumroad/
/dist-itch/
/dist_studio*/
# NOTE: the generated bundles are committed on purpose so a fresh clone can be
# verified against a build; only the root-level copies are ignored.
/app.js
/canvas-editor.js
/native/inkcore/build/

# Screenshot that must not be published (contains third-party artwork)
/build/ui-preview.png

# Local scratch / migration helpers
/.tmp-ref/
/scripts/_migrate-*.js
/scripts/_*.js
/scripts/_*.txt
/_patch-*.js
*.log

# Test artifacts (screenshots, temporary captures, ad-hoc probes)
/tests/_shot-*.png
/tests/_*.png
/tests/screen-parity-*.png
/tests/tile-stale-*.png
/tests/tmp-*/
/tests/_qa/_out/
/tests/_bug-hunt/
*.tmp.png
*.tmp

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# Local environment / secrets
.env
.env.*
!.env.example

# Package-manager caches
.cache/
.eslintcache
